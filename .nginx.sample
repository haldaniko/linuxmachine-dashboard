server {
    listen 80;
    server_name example.com www.example.com;

    client_max_body_size 20m;

    # Optional: redirect HTTP to HTTPS if TLS is configured in another server block.
    # return 301 https://$host$request_uri;

    location /dashboard/ {
        proxy_pass http://127.0.0.1:8050/dashboard/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# If you publish the app at the domain root instead of /dashboard/,
# build with VITE_BASE_PATH=/ and use this location instead:
#
# location / {
#     proxy_pass http://127.0.0.1:8050/;
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }
